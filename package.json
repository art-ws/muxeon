{
  "name": "@art-ws/muxeon",
  "version": "0.1.11",
  "type": "module",
  "description": "Muxeon — transport and coordinator for local CLI agents running in tmux sessions.",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "orchestration",
    "coordinator",
    "tmux",
    "mcp",
    "model-context-protocol",
    "claude",
    "codex",
    "cli",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/art-ws/muxeon.git"
  },
  "homepage": "https://github.com/art-ws/muxeon#readme",
  "bugs": {
    "url": "https://github.com/art-ws/muxeon/issues"
  },
  "bin": {
    "muxeon": "bin/muxeon.js"
  },
  "files": [
    "bin",
    "dist",
    "muxeon.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ui": "bun run --cwd packages/webchat-ui build",
    "build:server": "bun build packages/server/src/index.ts --target bun --outdir dist",
    "build": "bun run build:server",
    "build:dist": "bun run build:ui && bun run build:server && bun run scripts/stage-ui.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "secretlint": "secretlint \"**/*\"",
    "test": "bun test --timeout 30000"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "^1.2.0",
    "secretlint": "^13.0.4",
    "semantic-release": "^25.0.8",
    "typescript": "^5.7.0"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
