{
  "name": "my-team",
  "server": {
    "port": 8080,
    "mcp": true,
    "retain": {
      "age": "7d",
      "count": 1000
    }
  },
  "agents": [
    {
      "name": "researcher",
      "title": "Researcher",
      "type": "claude",
      "tmux": "researcher",
      "cwd": "/path/to/repo",
      "provision": {
        "command": ["claude"],
        "cwd": "/path/to/repo",
        "auto": true,
        "teardown": {
          "slash": "exit",
          "graceMs": 5000,
          "idle": "1h"
        }
      },
      "commands": [
        {
          "slash": "clear"
        },
        {
          "slash": "compact"
        }
      ],
      "group": "workers",
      "tags": ["research"],
      "exported": true
    },
    {
      "name": "writer",
      "type": "codex",
      "tmux": "writer",
      "replyVia": "auto",
      "wipLimit": 3,
      "group": "workers",
      "tags": ["docs"]
    }
  ],
  "groups": [
    {
      "name": "workers"
    }
  ],
  "types": {
    "claude": {
      "tokens": {
        "enabled": true,
        "sampleEvery": "60s",
        "minuteSpan": "60m",
        "maxThreshold": 1000000
      }
    },
    "codex": {
      "tokens": {
        "enabled": true
      }
    }
  },
  "reactions": {
    "categories": [
      {
        "name": "feedback",
        "title": "Feedback"
      },
      {
        "name": "work",
        "title": "Rework"
      }
    ],
    "items": [
      {
        "key": "ok",
        "emoji": "👍",
        "label": "Accepted",
        "category": "feedback",
        "agentMessage": "The operator marked this message as accepted. This is a notice; no answer is needed."
      },
      {
        "key": "redo",
        "emoji": "🔁",
        "label": "Redo",
        "category": "work",
        "expectsReply": true,
        "agentMessage": "The result in this message is not good enough. Re-read the requirement, find the weak spot and do it again; answer with what changed."
      },
      {
        "key": "verify",
        "emoji": "🧪",
        "label": "Verify",
        "category": "work",
        "expectsReply": true,
        "agentMessage": "Check the claims in this message against facts (tests, logs, files) and answer with the result of that check."
      },
      {
        "key": "fire",
        "emoji": "🔥",
        "label": "Fire"
      }
    ],
    "picker": {
      "recentLimit": 12
    }
  },
  "users": [
    {
      "name": "operator",
      "title": "Operator",
      "role": "admin",
      "auth": {
        "password": {
          "$env": "MUXEON_WEB_PASSWORD"
        }
      },
      "channels": {
        "web": true
      }
    }
  ],
  "topology": {
    "researcher": ["writer", "operator"],
    "writer": ["operator"],
    "operator": ["hq"]
  },
  "imports": [
    {
      "name": "hq",
      "url": "https://hq.example.com:8092",
      "token": {
        "$env": "MUXEON_FED_HQ_TOKEN"
      },
      "transit": true,
      "publish": false
    }
  ],
  "federation": {
    "port": 8092,
    "bind": "127.0.0.1",
    "publishStatus": true,
    "statusDebounceMs": 1000,
    "accept": [
      {
        "name": "branch",
        "token": {
          "$env": "MUXEON_FED_BRANCH_TOKEN"
        },
        "relay": false
      }
    ]
  },
  "commandGrants": {
    "writer": {
      "researcher": ["clear", "compact"]
    },
    "researcher": {
      "researcher": ["clear", "compact"]
    }
  },
  "sessionGrants": {
    "writer": {
      "researcher": ["restart"]
    },
    "researcher": {
      "researcher": ["restart"]
    }
  },
  "schedules": {
    "enabled": true,
    "maxChainsPerAgent": 8,
    "maxItems": 16,
    "minDelay": "5s",
    "maxDelay": "24h",
    "maxText": 32768,
    "idleWait": "60s",
    "quietWindow": "45s",
    "quietTimeout": "30m",
    "catchUpGrace": "10m"
  },
  "channels": [
    {
      "name": "web",
      "type": "webchat",
      "port": 8091,
      "basePath": "/team",
      "auth": {
        "mode": "users"
      }
    }
  ]
}
