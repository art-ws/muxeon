{
  "name": "my-team",

  "server": {
    "port": 8080,
    "mcp": true,
    "retain": { "age": "7d", "count": 1000 }
  },

  "agents": [
    {
      "name": "researcher",
      "title": "Researcher",
      "type": "claude",
      "tmux": "researcher",
      "cwd": "/path/to/repo",
      "provision": {
        "command": ["claude"],
        "cwd": "/path/to/repo",
        "auto": true,
        "teardown": { "slash": "exit", "graceMs": 5000, "idle": "1h" }
      },
      "commands": [{ "slash": "clear" }, { "slash": "compact" }],
      "group": "workers",
      "tags": ["research"],
      "exported": true
    },
    {
      "name": "writer",
      "type": "codex",
      "tmux": "writer",
      "replyVia": "auto",
      "wipLimit": 3,
      "group": "workers",
      "tags": ["docs"]
    }
  ],

  "groups": [{ "name": "workers" }],

  "users": [
    {
      "name": "operator",
      "title": "Operator",
      "role": "admin",
      "auth": { "password": { "$env": "MUXEON_WEB_PASSWORD" } },
      "channels": { "web": true }
    }
  ],

  "topology": {
    "researcher": ["writer", "operator"],
    "writer": ["operator"],
    "operator": ["hq"]
  },

  "imports": [
    {
      "name": "hq",
      "url": "https://hq.example.com:8092",
      "token": { "$env": "MUXEON_FED_HQ_TOKEN" },
      "transit": true,
      "publish": false
    }
  ],

  "federation": {
    "port": 8092,
    "bind": "127.0.0.1",
    "publishStatus": true,
    "statusDebounceMs": 1000,
    "accept": [{ "name": "branch", "token": { "$env": "MUXEON_FED_BRANCH_TOKEN" }, "relay": false }]
  },

  "commandGrants": {
    "writer": { "researcher": ["clear", "compact"] }
  },

  "sessionGrants": {
    "writer": { "researcher": ["restart"] }
  },

  "channels": [
    {
      "name": "web",
      "type": "webchat",
      "port": 8091,
      "basePath": "/team",
      "auth": { "mode": "users" }
    }
  ]
}
